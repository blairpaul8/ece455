// .vscode/launch.json
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TM4C123 (OpenOCD)",
      "type": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/blink.elf",
      "cwd": "${workspaceFolder}",
      "postRunCommands": [
        "target extended-remote localhost:3333",
        "monitor reset halt",
        "load"
      ]
    }
  ]
}
